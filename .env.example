# --- Server ---
PORT=3000
NODE_ENV=development
APP_MOUNT_PREFIX=

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=chain_saas_user
DB_PASSWORD=change_me
DB_NAME=chain_saas

# --- Security ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=chain_sid
SESSION_TTL_HOURS=168

# --- Public base URL ---
PUBLIC_BASE_URL=http://localhost:3000

# --- Meta / WhatsApp (Phase 3) ---
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=v20.0
WEBHOOK_VERIFY_TOKEN=change_me_meta_verify

# --- Gemini (Phase 3) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Payments (can be set later via super admin) ---
PAYMENTS_MOCK=true
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_BASE_URL=https://api.flutterwave.com/v3

# --- PWA / Web Push (Phase 6) ---
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Bootstrap only ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=